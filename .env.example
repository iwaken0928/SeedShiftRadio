# Shared local development settings
SEEDSHIFT_ADMIN_TOKEN=local-admin-token

# Server
SEEDSHIFT_RADIO_SERVER_PORT=8080
SEEDSHIFT_RADIO_CONFIG_PATH=./data/config/config.json
SEEDSHIFT_RADIO_JOBRUNR_ENABLED=true

# PostgreSQL
SEEDSHIFT_RADIO_DB_HOST=127.0.0.1
SEEDSHIFT_RADIO_DB_PORT=5432
SEEDSHIFT_RADIO_DB_NAME=seedshift_radio
SEEDSHIFT_RADIO_DB_USERNAME=seedshift
SEEDSHIFT_RADIO_DB_PASSWORD=seedshift

# Local AI services
SEEDSHIFT_RADIO_MUSICGEN_PORT=8000
SEEDSHIFT_RADIO_OLLAMA_PORT=11434
SEEDSHIFT_RADIO_VOICEVOX_PORT=50021
SEEDSHIFT_MUSICGEN_BACKEND=deterministic

# Web
SERVER_INTERNAL_API_BASE_URL=http://127.0.0.1:8080
SEEDSHIFT_WEB_ADMIN_PASSWORD=local-admin-password
SEEDSHIFT_WEB_SESSION_SECRET=local-development-session-secret-change-me

# Smoke verification
SEEDSHIFT_SMOKE_API_BASE_URL=http://127.0.0.1:8080
SEEDSHIFT_SMOKE_WEB_BASE_URL=http://127.0.0.1:3000
SEEDSHIFT_SMOKE_WORKER_BASE_URL=http://127.0.0.1:8000
