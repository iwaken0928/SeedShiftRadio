# Production deploy template. Copy values into GitLab CI/CD Variables or the
# deploy runner's protected environment, not into a committed .env file.

SEEDSHIFT_COMPOSE_PROJECT_NAME=seedshift-radio
SEEDSHIFT_DEPLOY_DIR=$HOME/seedshift-radio-deploy

# Images are normally written by GitLab CI during deploy.
SEEDSHIFT_SERVER_IMAGE=registry.example.com/group/seedshift-radio/server:commit-sha
SEEDSHIFT_WEB_IMAGE=registry.example.com/group/seedshift-radio/web:commit-sha

# Host-networked server connects to PostgreSQL on the same machine.
SEEDSHIFT_RADIO_SERVER_BIND=127.0.0.1
SEEDSHIFT_RADIO_SERVER_PORT=8080
SEEDSHIFT_RADIO_DB_HOST=127.0.0.1
SEEDSHIFT_RADIO_DB_PORT=5432
SEEDSHIFT_RADIO_DB_NAME=seedshift_radio
SEEDSHIFT_RADIO_DB_USERNAME=seedshift
SEEDSHIFT_RADIO_DB_PASSWORD=change-me

# Web is exposed directly from the host network.
SEEDSHIFT_WEB_HOSTNAME=0.0.0.0
SEEDSHIFT_WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=/api-proxy
SERVER_INTERNAL_API_BASE_URL=http://127.0.0.1:8080

# Secrets must be registered as masked/protected GitLab variables.
SEEDSHIFT_ADMIN_TOKEN=change-me
SEEDSHIFT_RADIO_CONFIG_PATH=/var/lib/seedshift-radio/config/config.json
SEEDSHIFT_RADIO_DATA_VOLUME=seedshift-radio-data
SEEDSHIFT_RADIO_JOBRUNR_ENABLED=true

# Set SEEDSHIFT_RADIO_DATA_VOLUME to an absolute host path only after preparing ownership for UID 10001.

# Smoke test URLs evaluated on the deploy runner host.
SEEDSHIFT_SMOKE_API_BASE_URL=http://127.0.0.1:8080
SEEDSHIFT_SMOKE_WEB_BASE_URL=http://127.0.0.1:3000
SEEDSHIFT_SMOKE_WEB_API_PROXY_BASE_URL=http://127.0.0.1:3000/api-proxy
