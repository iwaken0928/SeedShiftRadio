{
  "name": "seedshift-radio-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:e2e": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "start": "next start",
    "prepare:e2e-standalone": "node -e \"const fs=require('node:fs'); fs.cpSync('.next/static','.next/standalone/.next/static',{recursive:true}); if(fs.existsSync('public')) fs.cpSync('public','.next/standalone/public',{recursive:true})\"",
    "start:e2e": "npm run prepare:e2e-standalone && node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "test": "TMPDIR=/tmp TEMP=/tmp TMP=/tmp vitest run",
    "test:watch": "TMPDIR=/tmp TEMP=/tmp TMP=/tmp vitest",
    "e2e": "npm run build && TMPDIR=/tmp TEMP=/tmp TMP=/tmp PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "e2e:headed": "npm run build && TMPDIR=/tmp TEMP=/tmp TMP=/tmp PLAYWRIGHT_BROWSERS_PATH=0 playwright test --headed"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.64.2",
    "clsx": "^2.1.1",
    "next": "^15.5.20",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.10"
    },
    "vite": "^6.4.3",
    "ws": "^8.21.0"
  }
}
